# The public room server every build bakes in when nothing overrides it:
# the TWOTOP_ROOM repo variable in CI (apk.yml, web.yml, desktop.yml), the
# TWOTOP_ROOM environment variable for scripts/phone.sh. Change it here and
# the APK, the web build, the desktop builds and phone.sh all follow.
# Shell syntax: each of them sources this file with bash.
TWOTOP_ROOM_DEFAULT='wss://two-top-matchbox-production.up.railway.app/two-top?next=2'
